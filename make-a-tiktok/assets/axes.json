{
  "version": 2,
  "about": "Variation catalog. Every video picks one value per axis. `feature` and `persona` values come from the studio brand profile, and a brand or studio may add app-specific values to any axis or remove ones that are wrong for it (`axes.add`, `axes.remove`). Weights set how much each axis counts toward novelty. Length follows the content: comprehension comes before brevity, and every video stays under 45 seconds.",
  "weights": {
    "hook": 1.3,
    "opening": 1.0,
    "format": 1.3,
    "feature": 1.2,
    "register": 0.9,
    "world": 1.0,
    "music": 0.8,
    "persona": 0.7,
    "camera": 0.6,
    "cta": 0.5,
    "length": 0.5,
    "ending": 0.7,
    "palette": 0.4
  },
  "rules": {
    "window": 5,
    "minAxisDistance": 5,
    "noRepeatTriple": [
      "hook",
      "format",
      "feature"
    ],
    "noRepeatConsecutive": [
      "hook",
      "opening",
      "format",
      "register",
      "ending"
    ],
    "hookSimilarityMax": 0.35,
    "copySimilarityMax": 0.25,
    "featureCooldown": 2,
    "exploreShare": 0.3,
    "maxLength": 45,
    "sceneBaseSeconds": 1.5,
    "secondsPerWord": 0.3,
    "minSceneSeconds": 2.0,
    "maxWordsPerSecond": 2.6,
    "warnWordsPerSecond": 2.0,
    "soundWindow": 5,
    "minSoundDistance": 6,
    "noRepeatSoundConsecutive": [
      "family",
      "shape"
    ],
    "audioSimilarityFail": 0.78,
    "audioSimilarityWarn": 0.62,
    "blockOverlapFail": 0.7,
    "blockOverlapWarn": 0.45,
    "portfolioWindow": 4,
    "minPortfolioDistance": 6,
    "minPortfolioSoundDistance": 5,
    "overuseWindow": 4,
    "overuseCount": 3,
    "overuseAxes": [
      "hook",
      "opening",
      "format",
      "register",
      "world",
      "music",
      "camera",
      "cta",
      "ending"
    ],
    "reviewMinScore": 8,
    "reviewMinRounds": 2,
    "hookWordSimilarityMax": 0.6
  },
  "axes": {
    "hook": [
      {
        "id": "stakes-stat",
        "how": "Open on a number that hurts or thrills: a score, a rank, a price, a streak."
      },
      {
        "id": "pov",
        "how": "\"POV: ...\" puts the viewer inside a specific, relatable moment."
      },
      {
        "id": "question",
        "how": "Ask the question the audience argues about. Answer it by the end."
      },
      {
        "id": "bold-claim",
        "how": "A confident, defensible claim that makes the viewer want to disagree."
      },
      {
        "id": "myth-bust",
        "how": "\"Stop doing X.\" Name a common habit and show why it costs them."
      },
      {
        "id": "before-after",
        "how": "Show the painful before and the clean after within the first two seconds."
      },
      {
        "id": "countdown",
        "how": "A visible clock or deadline creates urgency from frame one."
      },
      {
        "id": "list-promise",
        "how": "\"3 moves that ...\" promises a payoff the viewer stays for."
      },
      {
        "id": "challenge",
        "how": "\"Can the AI ...?\" A bet or test with a reveal."
      },
      {
        "id": "confession",
        "how": "A first-person admission: \"I finished last. Then ...\""
      },
      {
        "id": "versus",
        "how": "Two ways to do the job, side by side. The old way loses."
      },
      {
        "id": "secret",
        "how": "\"The trick nobody uses\": a specific, non-obvious tactic."
      },
      {
        "id": "reaction",
        "how": "Open on a reaction: a group chat, a notification storm, a rival's message."
      },
      {
        "id": "quiz",
        "how": "\"Pick one.\" Pause for a beat, then reveal what the product picked and why."
      }
    ],
    "opening": [
      {
        "id": "type-slam",
        "how": "Huge kinetic type fills the frame; the line is the picture."
      },
      {
        "id": "product-mid-action",
        "how": "The real product UI, already mid-interaction, with no headline over it."
      },
      {
        "id": "object-closeup",
        "how": "One object or image fills the frame (a photo, a card, a chart) with a small caption."
      },
      {
        "id": "big-number",
        "how": "A single number at poster scale; its label arrives after."
      },
      {
        "id": "message-bubble",
        "how": "A message, comment, or notification is the first thing on screen."
      },
      {
        "id": "cursor-on-blank",
        "how": "An almost empty frame with a cursor or caret about to act."
      },
      {
        "id": "result-first",
        "how": "Open on the finished outcome and explain it later."
      },
      {
        "id": "split-contrast",
        "how": "Two halves in contrast from the first frame."
      },
      {
        "id": "question-card",
        "how": "A question set small like a label or a card, with a lot of space around it."
